[Unit]
Description=What to Eat Telegram Bot
Documentation=file:/root/what-to-eat-telegram-bot/docs/DEPLOYMENT.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/what-to-eat-telegram-bot
ExecStart=/root/what-to-eat-telegram-bot/.venv/bin/python -m what_to_eat_bot
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
UMask=0077
PrivateTmp=true
ProtectSystem=strict
ProtectHome=no
ReadWritePaths=/root/what-to-eat-telegram-bot/data
StandardOutput=journal
StandardError=journal
SyslogIdentifier=what-to-eat-bot

[Install]
WantedBy=multi-user.target
