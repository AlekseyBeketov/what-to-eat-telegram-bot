# Copy to .env and set the token from BotFather.
BOT_TOKEN=replace_with_telegram_bot_token

# Writable SQLite path. Parent directory is created automatically.
DATABASE_PATH=./data/what_to_eat.sqlite3

# INFO, DEBUG, WARNING, ERROR
LOG_LEVEL=INFO

# Invite lifetime in hours.
INVITE_TTL_HOURS=72

# Optional public bot username without @, used to build family deep links.
BOT_USERNAME=
